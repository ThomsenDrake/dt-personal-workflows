# Required: your Mistral API key (https://console.mistral.ai)
MISTRAL_API_KEY=

# The built-in "espn" live-odds source needs no key (public ESPN JSON APIs).
# Optional: key for an extra feed if you register a new source in
# workflows/ncaa-d1-best-line/worker/src/worker/workflows/sources.py
# (e.g. The Odds API - https://the-odds-api.com, sport key americanfootball_ncaaf)
# ODDS_API_KEY=

# cn-astroturf-mapper (workflows/cn-astroturf-mapper): optional x.md
# (https://mdfromx.com) API key for a higher bulk-import allowance — NOT an X
# API token. Without it, x.md limits imports to ~3/hour, 5/day per IP.
# X_MD_API_KEY=
# Self-hosted x.md instance (default https://mdfromx.com):
# X_MD_BASE_URL=https://xmd.drake-t.workers.dev

# Optional: xAI API key enabling the grok_x_search handle source in
# cn-astroturf-mapper (xAI Responses API x_search tool; billed per post fetched
# — an xAI meter, not X's pay-per-use API; never an X token or a grok.com
# login). Used when the input's handle_source is "grok_x_search" or "auto".
# XAI_API_KEY=
# XAI_XSEARCH_MODEL=grok-4.7
# For handle_source "grok_cli" (Grok Build CLI headless, uses the CLI's own
# cached login — never handled by the workflow itself):
# GROK_BIN=grok            # or ~/.grok/bin/grok
# GROK_HOME=              # optional: dir holding ~/.grok/auth.json (secret volume)
# Optional overrides for the public Community Notes dataset snapshot layout
# (daily snapshots at YYYY/MM/DD/<table>/<prefix>-NNNNN.zip):
# CN_DATA_BASE=https://ton.twimg.com/birdwatch-public-data
# CN_LOOKBACK_DAYS=7
# CN_MAX_SHARDS=64

# epub-voxtral-audiobook (workflows/epub-voxtral-audiobook): no extra keys
# needed. Locally only MISTRAL_API_KEY is used (chat + /v1/audio/speech);
# on the managed deployment the platform injects the service-account token,
# and Google Drive access comes from the starting user's google_drive_mcp
# connector credential (the workflow is on_behalf_of=True), not from a secret.
